{
  "name": "nsdcaseb",
  "compatibility_date": "2026-09-30",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "NOTIFY_KV",
      "id": "9b54a4a0c174444e8b64cb7a2a590d47"
    }
  ]
}
