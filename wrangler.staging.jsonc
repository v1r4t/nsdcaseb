{
  "name": "nsdcaseb-staging",
  "compatibility_date": "2026-09-30",
  "main": "worker/staging.ts",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "nsdc-auth",
      "database_id": "2c866704-7c1f-4556-b1b7-6bd9fc3d8709",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATELIMIT_KV",
      "id": "5535eca24d924115ad24c5b3d22af89f"
    }
  ]
}