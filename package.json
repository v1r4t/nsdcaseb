{
  "name": "nsdcaseb",
  "version": "1.0.0",
  "description": "NSDC — National Student Data Corps club site (Amrita Vishwa Vidyapeetham, Bengaluru)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:site": "vite -c site/vite.config.ts",
    "typecheck:site": "tsc -p site",
    "build:site": "vite build -c site/vite.config.ts",
    "build:all": "npm run build && npm run build:site",
    "migrate:staging": "wrangler d1 migrations apply nsdc-auth --remote -c wrangler.staging.jsonc",
    "deploy:staging": "npm run build:site && wrangler deploy -c wrangler.staging.jsonc",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
