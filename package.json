{
  "name": "nsdcaseb",
  "version": "1.0.0",
  "description": "National Student Data Corps — Coming Soon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:site": "vite -c site/vite.config.ts",
    "typecheck:site": "tsc -p site",
    "build:site": "vite build -c site/vite.config.ts",
    "build:all": "npm run build && npm run build:site",
    "migrate:staging": "wrangler d1 migrations apply nsdc-auth --remote -c wrangler.staging.jsonc",
    "deploy:staging": "npm run build:site && wrangler deploy -c wrangler.staging.jsonc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
